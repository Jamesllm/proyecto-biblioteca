						"body": {
							"mode": "raw",
							"raw": "{\n  \"idEjemplar\": 2,\n  \"idUsuario\": 1\n}"
						},
						"url": "{{baseUrl}}/api/prestamos"
					}
				},
				{
					"name": "Registrar Devolución (Calcula mora de días/horas automáticamente)",
					"request": {
						"method": "PUT",
						"header": [{"key": "Content-Type", "value": "application/json"}],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"fechaHoraDevolucionReal\": \"2026-10-25T11:30:00\",\n  \"estadoConservacion\": \"BUENO\",\n  \"observaciones\": \"Devuelto en buenas condiciones con ligero retraso\",\n  \"montoDanoExtra\": 0.0\n}"
						},
						"url": "{{baseUrl}}/api/prestamos/1/devolver"
					}
				}
			]
		},
