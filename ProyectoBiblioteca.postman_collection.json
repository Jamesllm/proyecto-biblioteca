{
	"info": {
		"_postman_id": "a5e8f49a-32c0-43b9-a9a7-96a938634125",
		"name": "Proyecto Biblioteca API (Fase 3 - JWT & PostgreSQL)",
		"description": "Colección completa de peticiones HTTP para el Sistema de Gestión de Biblioteca (Java 21, Spring Boot, PostgreSQL, Spring Security & JWT).",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "0. Autenticación & JWT",
			"item": [
				{
					"name": "Login Administrador",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.token) {",
									"    pm.environment.set('token', jsonData.token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [{"key": "Content-Type", "value": "application/json"}],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"admin@biblioteca.com\",\n  \"password\": \"admin123\"\n}"
						},
						"url": "{{baseUrl}}/api/auth/login"
					}
				},
				{
					"name": "Login Lector (Estudiante)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.token) {",
									"    pm.environment.set('token', jsonData.token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [{"key": "Content-Type", "value": "application/json"}],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"carlos.mendoza@email.com\",\n  \"password\": \"carlos123\"\n}"
						},
						"url": "{{baseUrl}}/api/auth/login"
					}
				},
				{
					"name": "Registro de Nuevo Usuario",
					"request": {
						"method": "POST",
						"header": [{"key": "Content-Type", "value": "application/json"}],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"dni\": \"87654321\",\n  \"nombre\": \"Alejandro Perez\",\n  \"email\": \"alejandro.perez@email.com\",\n  \"password\": \"secreto123\",\n  \"telefono\": \"+51 911223344\",\n  \"direccion\": \"Av. Universitaria 1500\",\n  \"tipoUsuario\": \"ESTUDIANTE\",\n  \"rol\": \"ROLE_ESTUDIANTE\"\n}"
						},
						"url": "{{baseUrl}}/api/auth/register"
					}
				},
				{
					"name": "Obtener Perfil Actual (Requiere Token)",
					"request": {
						"method": "GET",
						"header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
						"url": "{{baseUrl}}/api/auth/me"
					}
				}
			]
		},
		{
			"name": "1. Inicio y Estado",
			"item": [
				{
					"name": "Información de la API",
					"request": {
						"method": "GET",
						"url": "{{baseUrl}}/"
					}
				}
			]
		},
		{
			"name": "2. Libros (Catálogo por ISBN)",
			"item": [
				{
					"name": "Listar todos los libros (Público)",
					"request": {
						"method": "GET",
						"url": "{{baseUrl}}/api/libros"
					}
				},
				{
					"name": "Obtener libro por ISBN",
					"request": {
						"method": "GET",
						"url": "{{baseUrl}}/api/libros/978-0307474728"
					}
				},
				{
					"name": "Ver ejemplares de un libro por ISBN",
					"request": {
						"method": "GET",
						"url": "{{baseUrl}}/api/libros/978-0307474728/ejemplares"
					}
				},
				{
					"name": "Crear nuevo libro (Requiere Token)",
					"request": {
						"method": "POST",
						"header": [
							{"key": "Content-Type", "value": "application/json"},
							{"key": "Authorization", "value": "Bearer {{token}}"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"isbn\": \"978-8437604183\",\n  \"titulo\": \"Pedro Páramo\",\n  \"sinopsis\": \"Novela cumbre del realismo mágico mexicano\",\n  \"idAutor\": 3,\n  \"idCategoria\": 1,\n  \"idEditorial\": 2,\n  \"anioPublicacion\": 1955\n}"
						},
						"url": "{{baseUrl}}/api/libros"
					}
				}
			]
		},
		{
			"name": "3. Ejemplares (Copias Físicas)",
			"item": [
				{
					"name": "Listar todos los ejemplares",
					"request": {
						"method": "GET",
						"url": "{{baseUrl}}/api/ejemplares"
					}
				},
				{
					"name": "Crear nueva copia de libro (Requiere Token)",
					"request": {
						"method": "POST",
						"header": [
							{"key": "Content-Type", "value": "application/json"},
							{"key": "Authorization", "value": "Bearer {{token}}"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"isbn\": \"978-0307474728\",\n  \"numeroCopia\": 3,\n  \"ubicacion\": \"Estantería A-1, Fila 3\",\n  \"estadoConservacion\": \"EXCELENTE\",\n  \"estado\": \"DISPONIBLE\"\n}"
						},
						"url": "{{baseUrl}}/api/ejemplares"
					}
				}
			]
		},
		{
			"name": "4. Usuarios & Consultas de Préstamos",
			"item": [
				{
					"name": "Listar usuarios (Requiere Token)",
					"request": {
						"method": "GET",
						"header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
						"url": "{{baseUrl}}/api/usuarios"
					}
				},
				{
					"name": "Consultar historial detallado de préstamos del usuario",
					"request": {
						"method": "GET",
						"header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
						"url": "{{baseUrl}}/api/usuarios/3/prestamos"
					}
				},
				{
					"name": "Consultar libros prestados activos del usuario",
					"request": {
						"method": "GET",
						"header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
						"url": "{{baseUrl}}/api/usuarios/3/prestamos/activos"
					}
				}
			]
		},
		{
			"name": "5. Préstamos y Devoluciones",
			"item": [
				{
					"name": "Listar todos los préstamos",
					"request": {
						"method": "GET",
						"header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
						"url": "{{baseUrl}}/api/prestamos"
					}
				},
				{
					"name": "Registrar nuevo préstamo",
					"request": {
						"method": "POST",
						"header": [
							{"key": "Content-Type", "value": "application/json"},
							{"key": "Authorization", "value": "Bearer {{token}}"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"idEjemplar\": 2,\n  \"idUsuario\": 3\n}"
						},
						"url": "{{baseUrl}}/api/prestamos"
					}
				},
				{
					"name": "Registrar Devolución (Calcula mora automáticamente)",
					"request": {
						"method": "PUT",
						"header": [
							{"key": "Content-Type", "value": "application/json"},
							{"key": "Authorization", "value": "Bearer {{token}}"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"fechaHoraDevolucionReal\": \"2026-10-25T11:30:00\",\n  \"estadoConservacion\": \"BUENO\",\n  \"observaciones\": \"Devuelto con retraso\"\n}"
						},
						"url": "{{baseUrl}}/api/prestamos/1/devolver"
					}
				}
			]
		},
		{
			"name": "6. Multas y Pagos",
			"item": [
				{
					"name": "Listar todas las multas",
					"request": {
						"method": "GET",
						"header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
						"url": "{{baseUrl}}/api/multas"
					}
				},
				{
					"name": "Pagar Multa (Emite comprobante y desbloquea usuario)",
					"request": {
						"method": "POST",
						"header": [
							{"key": "Content-Type", "value": "application/json"},
							{"key": "Authorization", "value": "Bearer {{token}}"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"montoPagado\": 15.00,\n  \"metodoPago\": \"EFECTIVO\",\n  \"comprobante\": \"REC-000501\"\n}"
						},
						"url": "{{baseUrl}}/api/multas/1/pagar"
					}
				}
			]
		},
		{
			"name": "7. Reservas",
			"item": [
				{
					"name": "Listar reservas activas",
					"request": {
