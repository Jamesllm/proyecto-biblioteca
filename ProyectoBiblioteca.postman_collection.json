		"name": "Proyecto Biblioteca API (Fase 1 - Integral)",
		"description": "Colección completa de peticiones HTTP para el Sistema de Gestión de Biblioteca (Java 21 & Spring Boot). Incluye operaciones CRUD completas, gestión de ISBN, Ejemplares físicos, Préstamos con LocalDateTime, cálculo automático de mora en devoluciones, Pagos de Multas con comprobante, Reservas y consultas detalladas por usuario.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "0. Inicio y Estado",
			"item": [
				{
					"name": "Información de la API",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/",
							"host": ["{{baseUrl}}"],
							"path": [""]
						}
					}
				}
			]
		},
		{
			"name": "1. Libros (Catálogo por ISBN)",
			"item": [
				{
					"name": "Listar todos los libros",
					"request": {
						"method": "GET",
						"url": "{{baseUrl}}/api/libros"
					}
				},
				{
					"name": "Obtener libro por ISBN",
					"request": {
						"method": "GET",
						"url": "{{baseUrl}}/api/libros/978-0307474728"
					}
				},
				{
					"name": "Ver ejemplares de un libro por ISBN",
					"request": {
						"method": "GET",
						"url": "{{baseUrl}}/api/libros/978-0307474728/ejemplares"
					}
				},
				{
					"name": "Ver ejemplares disponibles de un ISBN",
					"request": {
						"method": "GET",
						"url": "{{baseUrl}}/api/libros/978-0307474728/ejemplares/disponibles"
					}
				},
				{
					"name": "Crear nuevo libro",
					"request": {
						"method": "POST",
						"header": [{"key": "Content-Type", "value": "application/json"}],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"isbn\": \"978-8437604183\",\n  \"titulo\": \"Pedro Páramo\",\n  \"sinopsis\": \"Novela cumbre del realismo mágico mexicano\",\n  \"idAutor\": 3,\n  \"idCategoria\": 1,\n  \"idEditorial\": 2,\n  \"anioPublicacion\": 1955\n}"
						},
						"url": "{{baseUrl}}/api/libros"
					}
				},
				{
					"name": "Actualizar libro por ISBN",
					"request": {
						"method": "PUT",
						"header": [{"key": "Content-Type", "value": "application/json"}],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"isbn\": \"978-0307474728\",\n  \"titulo\": \"Cien años de soledad (Edición Conmemorativa)\",\n  \"sinopsis\": \"Edición especial de la obra de García Márquez\",\n  \"idAutor\": 1,\n  \"idCategoria\": 1,\n  \"idEditorial\": 1,\n  \"anioPublicacion\": 1967\n}"
						},
						"url": "{{baseUrl}}/api/libros/978-0307474728"
					}
				},
				{
					"name": "Eliminar libro por ISBN",
					"request": {
						"method": "DELETE",
						"url": "{{baseUrl}}/api/libros/978-8437604183"
					}
				}
			]
		},
